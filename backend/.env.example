# WebOper — SOMENTE LEITURA. Mesmas credenciais dos outros projetos (Extras, Vales).
WEBOPER_DB_HOST=
WEBOPER_DB_PORT=3306
WEBOPER_DB_USER=
WEBOPER_DB_PASSWORD=
WEBOPER_DB_NAME=
WEBOPER_DB_CHARSET=latin1
WEBOPER_DIAS_OPERACAO=30

# Geoapify — plano gratuito: 3.000 créditos por dia, sem cartão.
GEOAPIFY_API_KEY=
GEOAPIFY_MODO_ROTA=approximated_transit

# Regra de vale-transporte: R$ 5 por sentido, R$ 10 por dia.
VT_TARIFA_SENTIDO=5.00
# Conduções de ônibus/BRT/VLT que o Jaé integra numa tarifa (2 ou 3, a confirmar).
VT_MAX_CONDUCOES_JAE=2
VT_RAIO_CAMINHAVEL_KM=2.0
# Postos mais próximos que consultam rota em cada análise.
ANALISE_TOP_POSTOS=5
